{
  "name": "cangoctoado-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/rooms.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:auth": "tsx --env-file=.env --test test/auth.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "argon2": "^0.44.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
